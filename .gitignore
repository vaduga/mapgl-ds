# Node.js
node_modules/
/.cache/
/*.zip

# Rust
/target/
wasm-core/target/

# Keep generated JS glue and WASM tracked so reviews do not require a Rust
# toolchain. Regenerate them after changing the Rust crate.
wasm-core/pkg/*
!wasm-core/pkg/agent_core.js
!wasm-core/pkg/agent_core_bg.wasm

# Build output
/dist/
/dist_pro/

# Local Docker persistence
/docker_data/

