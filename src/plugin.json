{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Mapgl Traces",
  "id": "vaduga-mapgl-datasource",
  "metrics": true,
  "tracing": true,
  "info": {
    "keywords": ["tempo", "traces", "service graph", "service dependency graph", "node graph"],
    "description": "Query Tempo to render traces with Mapgl panel node graph.",
    "author": {
      "name": "Vadim Pyatakov"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://mapgl.org"
      },
      {
        "name": "Repository",
        "url": "https://github.com/vaduga/mapgl-ds"
      }
    ],
    "screenshots": [
      {
        "name": "Traces on service graph",
        "path": "img/screenshots/screenshot1.png"
      },
      {
        "name": "Query options",
        "path": "img/screenshots/screenshot2.png"
      }
    ],
    "version": "0.1.0",
    "updated": "2026-06-06"
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.0"
  }
}
